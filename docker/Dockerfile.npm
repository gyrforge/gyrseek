# Base image. The default matches gyrseek's built-in Node 26 image. To match your project's Node,
# pass one of the digest-pinned images gyrseek ships (see NODE_IMAGES in src/runtime_image.rs):
#   docker build --build-arg NODE_BASE=node:22-bookworm-slim@sha256:<digest> ...
ARG NODE_BASE=node:26.3-bookworm-slim@sha256:9898bb74f4ee319780e87819df703b3633113bc3422f151fd11155cf974a2749
# hadolint ignore=DL3006
FROM ${NODE_BASE}

# hadolint ignore=DL3008,DL3016
RUN apt-get update && \
    apt-get install -y --no-install-recommends strace ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    if ! corepack enable pnpm >/dev/null 2>&1; then npm install -g pnpm >/dev/null; fi

RUN id -u gyrseek >/dev/null 2>&1 \
    || useradd -m -d /home/gyrseek -s /bin/sh gyrseek \
    || adduser -D -h /home/gyrseek -s /bin/sh gyrseek

RUN mkdir -p /work && chown -R gyrseek /work
