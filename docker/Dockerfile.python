FROM python:3.13-slim-bookworm@sha256:05b95397cac02b060ff1251afaa78087d92d7034369afbc8eb765631cada8257

# hadolint ignore=DL3008,DL3013
RUN apt-get update && \
    apt-get install -y --no-install-recommends strace ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    python -m pip install --no-cache-dir --quiet uv

RUN id -u gyrseek >/dev/null 2>&1 \
    || useradd -m -d /home/gyrseek -s /bin/sh gyrseek \
    || adduser -D -h /home/gyrseek -s /bin/sh gyrseek

RUN mkdir -p /work && chown -R gyrseek /work
