# Base image. The default matches gyrseek's built-in Python 3.13 image. To match your project's
# Python, pass one of the digest-pinned images gyrseek ships (see PYTHON_IMAGES in src/sandbox.rs):
#   docker build --build-arg PYTHON_BASE=python:3.12-slim-bookworm@sha256:<digest> ...
ARG PYTHON_BASE=python:3.13-slim-bookworm@sha256:a5a7017efc5969e00ae2b91c8eb0631049a569652aa4ffc4501769049ae45c72
# hadolint ignore=DL3006
FROM ${PYTHON_BASE}

# hadolint ignore=DL3008,DL3013
RUN apt-get update && \
    apt-get install -y --no-install-recommends strace ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    python -m pip install --no-cache-dir --quiet uv

RUN id -u gyrseek >/dev/null 2>&1 \
    || useradd -m -d /home/gyrseek -s /bin/sh gyrseek \
    || adduser -D -h /home/gyrseek -s /bin/sh gyrseek

RUN mkdir -p /work && chown -R gyrseek /work
