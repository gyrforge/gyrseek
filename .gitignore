# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

tests/npm/node_modules/
tests/pnpm/node_modules/
tests/pnpm/pnpm-lock.yaml
node_modules/
package-lock.json
package.json
# Committed test fixtures, not generated files. The bare patterns above match at any depth, and
# git only ignores untracked files, so a fixture that is ever removed and re-added would silently
# stop being tracked and CI would check out an incomplete fixture directory. Negate each one.
!tests/scale/package.json
!tests/scale/package-lock.json
!tests/npm/package.json
!tests/npm/package-lock.json
!tests/pnpm/package.json

# Graphify outputs: keep canonical artifacts, ignore run-state and cache files.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html

__pycache__/
.venv/
